# PostgreSQL (Neon, Supabase o local)
# En Neon usa la cadena "pooler" para Vercel.
DATABASE_URL=postgresql://usuario:contrasena@host/db?sslmode=require
DB_SSL=true

# Servidor
PORT=4001
# Dominios permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:3000

# Asistente de IA (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
